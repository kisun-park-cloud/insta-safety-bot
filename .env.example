# GitHub 저장소 Settings → Secrets and variables → Actions 에 등록하는 값

# [Secrets]
IG_ACCESS_TOKEN=IGAA...      # 인스타그램 장기 토큰(60일)
IG_USER_ID=                  # 비워두면 토큰으로 자동 조회
GH_PAT=                      # 토큰 자동 갱신용 (Secrets 쓰기 권한 Fine-grained 토큰)
TELEGRAM_BOT_TOKEN=          # 선택: 결과 알림
TELEGRAM_CHAT_ID=

# [Variables]
PUBLIC_BASE_URL=https://kisun-park-cloud.github.io/insta-safety-bot
DRY_RUN=true                 # false 로 바꿔야 실제 게시
