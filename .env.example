# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Instagram API with Instagram Login (크리에이터/비즈니스 계정, 페이스북 페이지 불필요)
IG_ACCESS_TOKEN=IGAA...      # 장기 토큰(60일) — 토큰 자동 갱신 워크플로 사용 권장
IG_USER_ID=                  # 비워두면 토큰으로 자동 조회
IG_GRAPH_VERSION=v23.0

# 인스타그램이 이미지/영상을 가져갈 공개 URL (GitHub Pages 등)
PUBLIC_BASE_URL=https://<github-id>.github.io/insta-safety-bot

# 검수 결과 알림(선택): 텔레그램 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true 이면 업로드 직전까지만 실행 (시험 운영용)
DRY_RUN=true
